name = "yexe-proxy-edge"
main = "src/worker.ts"
compatibility_date = "2026-06-02"
workers_dev = true

[vars]
# Public worker endpoint:
# https://yexe.workers.dev
#
# Set this to the public HTTPS endpoint of your VPS reverse proxy.
# Do not point this directly at your home server.
VPS_ORIGIN = "https://vps-proxy.example.com"
