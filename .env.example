COOKIE_STORE=file
DATABASE_URL=postgres://proxy:secret@127.0.0.1:5432/proxy
COOKIE_USER_ID_SECRET=replace-with-random-secret
COOKIE_TTL_DAYS=60
COOKIE_FILE_STORE_DIR=.cookie-store
SCRAMJET_SKIP_RSPACK=1

DEMO_PORT=4141
WISP_PORT=4142

# Public edge origin. For the worker.dev deployment, set this on the VPS/home
# server so the browser uses the worker.dev Wisp endpoint instead of localhost.
# VITE_PUBLIC_ORIGIN=https://yexe.workers.dev
# VITE_WISP_URL=wss://yexe.workers.dev/wisp/
